[{"start": 0.8, "end": 1.82, "text": "Yo everybody."}, {"start": 1.9, "end": 3.45, "text": "Just after a long day of hacking,"}, {"start": 3.48, "end": 4.12, "text": "just like you,"}, {"start": 4.15, "end": 5.42, "text": "I need to go to the toilet."}, {"start": 5.5, "end": 6.82, "text": "But where is it here?"}, {"start": 6.9, "end": 7.72, "text": "I don't know."}, {"start": 7.8, "end": 9.52, "text": "So I got the schematics of this building here."}, {"start": 9.6, "end": 10.42, "text": "Secret intel."}, {"start": 10.5, "end": 12.81, "text": "And since I have not been thinking all day long,"}, {"start": 12.84, "end": 14.12, "text": "I will continue doing that."}, {"start": 14.2, "end": 15.52, "text": "So, I take out my AI."}, {"start": 15.6, "end": 17.82, "text": "I'm gonna take a picture of it."}, {"start": 17.9, "end": 19.27, "text": "And then I will ask it,"}, {"start": 19.3, "end": 20.92, "text": "where are the toilets here?"}, {"start": 21.0, "end": 21.46, "text": "So, well,"}, {"start": 21.49, "end": 22.82, "text": "let's see where they are."}, {"start": 22.9, "end": 24.02, "text": "It's thinking a bit."}, {"start": 24.1, "end": 25.22, "text": "It's thinking, it's thinking."}, {"start": 25.3, "end": 26.68, "text": "It says they're over there,"}, {"start": 26.71, "end": 27.62, "text": "and that is wrong."}, {"start": 27.7, "end": 28.72, "text": "My god, what is this?"}, {"start": 28.8, "end": 29.8, "text": "Frontier intelligence,"}, {"start": 29.83, "end": 32.62, "text": "and it cannot even tell me where I need to go to the toilet."}, {"start": 32.7, "end": 35.27, "text": "Well, I'm finding an organizer."}, {"start": 35.5, "end": 37.67, "text": "Reading a floor plan looks easy."}, {"start": 37.7, "end": 39.59, "text": "For an AI agent, it isnt:"}, {"start": 39.62, "end": 41.24, "text": "it has to see the walls,"}, {"start": 41.27, "end": 42.27, "text": "find the scale,"}, {"start": 42.3, "end": 43.85, "text": "and measure every room."}, {"start": 44.4, "end": 46.71, "text": "So we built DrawingSense."}, {"start": 46.74, "end": 49.05, "text": "One drawing, eight tools."}, {"start": 49.08, "end": 49.89, "text": "No shell."}, {"start": 49.92, "end": 50.64, "text": "No code."}, {"start": 50.67, "end": 52.79, "text": "Just spatial reasoning."}, {"start": 53.4, "end": 56.45, "text": "Walls and rooms count twenty-five percent each,"}, {"start": 56.48, "end": 58.15, "text": "doors and windows fifteen,"}, {"start": 58.18, "end": 59.66, "text": "fixtures and areas ten,"}, {"start": 59.69, "end": 61.23, "text": "with a speed multiplier."}, {"start": 61.8, "end": 62.97, "text": "Watch Gemini work."}, {"start": 63.0, "end": 65.31, "text": "It zooms, second-guesses its scale,"}, {"start": 65.34, "end": 67.32, "text": "then draws every room by hand."}, {"start": 67.35, "end": 70.66, "text": "Our plain computer-vision solver traces the walls."}, {"start": 70.69, "end": 73.27, "text": "Point five one against point zero four."}, {"start": 73.6, "end": 75.71, "text": "Across fifteen unseen plans,"}, {"start": 75.74, "end": 78.08, "text": "Gemini scores point three four."}, {"start": 78.11, "end": 78.93, "text": "Our solver:"}, {"start": 78.96, "end": 80.15, "text": "point five nine."}, {"start": 80.5, "end": 82.08, "text": "Eight ways it fails."}, {"start": 82.11, "end": 83.37, "text": "Two matter most:"}, {"start": 83.4, "end": 84.57, "text": "it quits early,"}, {"start": 84.6, "end": 86.43, "text": "and it skips the walls."}, {"start": 86.46, "end": 89.73, "text": "Then wrong scale, missed doors, timeouts,"}, {"start": 89.76, "end": 90.45, "text": "and more."}, {"start": 91.1, "end": 93.42, "text": "We tested many possible exploits."}, {"start": 93.45, "end": 95.41, "text": "None scored above point one."}, {"start": 95.9, "end": 97.54, "text": "And its reproducible."}, {"start": 97.57, "end": 99.07, "text": "Harbor, OpenCode, MCP,"}, {"start": 99.1, "end": 101.37, "text": "and one command for every number."}, {"start": 101.6, "end": 102.97, "text": "We trained two models."}, {"start": 103.0, "end": 103.36, "text": "First,"}, {"start": 103.39, "end": 105.52, "text": "a proof of concept on a large LLM,"}, {"start": 105.55, "end": 106.99, "text": "and its loss went down."}, {"start": 107.5, "end": 109.25, "text": "Second, a very small model,"}, {"start": 109.28, "end": 110.76, "text": "for Stoas challenge:"}, {"start": 110.79, "end": 113.85, "text": "verifiable answers about construction drawings."}, {"start": 114.5, "end": 115.91, "text": "Agents can see the drawing."}, {"start": 115.94, "end": 117.89, "text": "Now lets teach them to measure it."}]