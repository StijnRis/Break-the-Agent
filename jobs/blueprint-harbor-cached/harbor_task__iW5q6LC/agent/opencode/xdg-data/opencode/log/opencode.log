timestamp=2026-11-14T14:55:36.499Z level=INFO run=f84d4cbb message=evaluated permission=bash pattern="cat << 'EOF' > build_full.py\nimport json\nimport numpy as np\n\nwith open('blueprint_segments_fixed.json', 'r') as f:\n    rooms_data = json.load(f)\n\nseed_mapping = [\n    {\"id\": \"0.01\", \"name\": \"Balcon\"},\n    {\"id\": \"0.02\", \"name\": \"Piece\"},\n    {\"id\": \"0.03\", \"name\": \"Piece\"},\n    {\"id\": \"0.04\", \"name\": \"Bain\"},\n    {\"id\": \"0.07\", \"name\": \"Piece\"},\n    {\"id\": \"0.05\", \"name\": \"Cuisine\"},\n    {\"id\": \"0.08\", \"name\": \"Cuisine\"},\n    {\"id\": \"0.06\", \"name\": \"Piece\"},\n    {\"id\": \"0.09\", \"name\": \"Bain\"},\n    {\"id\": \"0.10\", \"name\": \"Couloir\"},\n    {\"id\": \"0.11\", \"name\": \"Balcon\"},\n    {\"id\": \"0.20\", \"name\": None},\n    {\"id\": \"0.12\", \"name\": \"Piece\"},\n    {\"id\": \"0.13\", \"name\": \"Cuisine\"},\n    {\"id\": \"0.14\", \"name\": \"Piece\"},\n    {\"id\": \"0.15\", \"name\": \"Couloir\"},\n    {\"id\": \"0.16\", \"name\": \"Bain\"},\n    {\"id\": \"0.17\", \"name\": \"Balcon\"},\n    {\"id\": \"0.18\", \"name\": \"Piece\"},\n    {\"id\": \"0.19\", \"name\": \"Piece\"}\n]\n\nrooms = []\nlines = []\n\nfor i, room in enumerate(rooms_data):\n    poly = room.get('polygon', [])\n    if not poly: continue\n    \n    rooms.append({\n        \"id\": seed_mapping[i][\"id\"],\n        \"name\": seed_mapping[i][\"name\"],\n        \"polygon\": poly\n    })\n    \n    for j in range(len(poly)):\n        p1 = poly[j]\n        p2 = poly[(j+1)%len(poly)]\n        if p1[0] == p2[0] or p1[1] == p2[1]:\n            # order points left-to-right, top-to-bottom\n            if p1[0] > p2[0] or p1[1] > p2[1]:\n                p1, p2 = p2, p1\n            lines.append({'p1': p1, 'p2': p2})\n\n# Merge lines\ndef merge_lines(lines):\n    merged = []\n    used = set()\n    for i, l1 in enumerate(lines):\n        if i in used: continue\n        \n        # group all lines that are collinear and overlapping\n        group = [l1]\n        used.add(i)\n        \n        is_horiz = l1['p1'][1] == l1['p2'][1]\n        \n        for j, l2 in enumerate(lines):\n            if j in used: continue\n            \n            is_horiz2 = l2['p1'][1] == l2['p2'][1]\n            if is_horiz != is_horiz2: continue\n            \n            if is_horiz:\n                # check if y is close\n                if abs(l1['p1'][1] - l2['p1'][1]) < 30:\n                    # check x overlap\n                    min_x = min(l1['p1'][0], l2['p1'][0])\n                    max_x = max(l1['p2'][0], l2['p2'][0])\n                    len1 = l1['p2'][0] - l1['p1'][0]\n                    len2 = l2['p2'][0] - l2['p1'][0]\n                    if (len1 + len2) >= (max_x - min_x) - 10:\n                        group.append(l2)\n                        used.add(j)\n            else:\n                # check if x is close\n                if abs(l1['p1'][0] - l2['p1'][0]) < 30:\n                    # check y overlap\n                    min_y = min(l1['p1'][1], l2['p1'][1])\n                    max_y = max(l1['p2'][1], l2['p2'][1])\n                    len1 = l1['p2'][1] - l1['p1'][1]\n                    len2 = l2['p2'][1] - l2['p1'][1]\n                    if (len1 + len2) >= (max_y - min_y) - 10:\n                        group.append(l2)\n                        used.add(j)\n                        \n        # Merge group\n        if is_horiz:\n            avg_y = sum([l['p1'][1] for l in group]) / len(group)\n            min_x = min([l['p1'][0] for l in group])\n            max_x = max([l['p2'][0] for l in group])\n            merged.append({'p1': [min_x, avg_y], 'p2': [max_x, avg_y], 'thickness_px': 20})\n        else:\n            avg_x = sum([l['p1'][0] for l in group]) / len(group)\n            min_y = min([l['p1'][1] for l in group])\n            max_y = max([l['p2'][1] for l in group])\n            merged.append({'p1': [avg_x, min_y], 'p2': [avg_x, max_y], 'thickness_px': 20})\n            \n    return merged\n\nwalls = merge_lines(lines)\n\nfixtures = [\n    {\"type\": \"washbasin\", \"x\": 1475, \"y\": 405},\n    {\"type\": \"wc\", \"x\": 1500, \"y\": 375},\n    {\"type\": \"bathtub\", \"x\": 1540, \"y\": 380},\n    {\"type\": \"kitchen\", \"x\": 1520, \"y\": 510},\n    {\"type\": \"kitchen\", \"x\": 1050, \"y\": 570},\n    {\"type\": \"washbasin\", \"x\": 1020, \"y\": 700},\n    {\"type\": \"wc\", \"x\": 1050, \"y\": 700},\n    {\"type\": \"bathtub\", \"x\": 1080, \"y\": 720},\n    {\"type\": \"kitchen\", \"x\": 1540, \"y\": 950},\n    {\"type\": \"washbasin\", \"x\": 1450, \"y\": 1100},\n    {\"type\": \"wc\", \"x\": 1500, \"y\": 1100},\n    {\"type\": \"bathtub\", \"x\": 1530, \"y\": 1100}\n]\n\nschematic = {\n    \"m_per_px\": 0.01693333,\n    \"walls\": walls,\n    \"rooms\": rooms,\n    \"doors\": [],\n    \"windows\": [],\n    \"fixtures\": fixtures\n}\n\nwith open('full_draft.json', 'w') as f:\n    json.dump(schematic, f)\nEOF" action.permission=* action.action=allow action.pattern=*
