timestamp=2026-11-14T14:49:58.933Z level=INFO run=f84d4cbb message=evaluated permission=bash pattern="cat << 'EOF' > build_draft.py\nimport json\n\nwith open('blueprint_segments.json', 'r') as f:\n    rooms_data = json.load(f)\n\n# Hardcode balconys\nrooms_data[0]['polygon'] = [[908, 127], [957, 127], [957, 323], [908, 323]]\nrooms_data[0]['closed'] = True\nrooms_data[10]['polygon'] = [[908, 783], [957, 783], [957, 978], [908, 978]]\nrooms_data[10]['closed'] = True\nrooms_data[17]['polygon'] = [[908, 1169], [957, 1169], [957, 1371], [908, 1371]]\nrooms_data[17]['closed'] = True\n\nschematic = {\n    \"m_per_px\": 0.01693333,\n    \"walls\": [],\n    \"rooms\": [],\n    \"doors\": [],\n    \"windows\": [],\n    \"fixtures\": []\n}\n\nseed_mapping = [\n    {\"id\": \"0.01\", \"name\": \"Balcon\"},\n    {\"id\": \"0.02\", \"name\": \"Piece\"},\n    {\"id\": \"0.03\", \"name\": \"Piece\"},\n    {\"id\": \"0.04\", \"name\": \"Bain\"},\n    {\"id\": \"0.07\", \"name\": \"Piece\"},\n    {\"id\": \"0.05\", \"name\": \"Cuisine\"},\n    {\"id\": \"0.08\", \"name\": \"Cuisine\"},\n    {\"id\": \"0.06\", \"name\": \"Piece\"},\n    {\"id\": \"0.09\", \"name\": \"Bain\"},\n    {\"id\": \"0.10\", \"name\": \"Couloir\"},\n    {\"id\": \"0.11\", \"name\": \"Balcon\"},\n    {\"id\": \"0.20\", \"name\": None},\n    {\"id\": \"0.12\", \"name\": \"Piece\"},\n    {\"id\": \"0.13\", \"name\": \"Cuisine\"},\n    {\"id\": \"0.14\", \"name\": \"Piece\"},\n    {\"id\": \"0.15\", \"name\": \"Couloir\"},\n    {\"id\": \"0.16\", \"name\": \"Bain\"},\n    {\"id\": \"0.17\", \"name\": \"Balcon\"},\n    {\"id\": \"0.18\", \"name\": \"Piece\"},\n    {\"id\": \"0.19\", \"name\": \"Piece\"}\n]\n\nfor i, room in enumerate(rooms_data):\n    if not room['polygon']: continue\n    \n    # We must format polygons to remove non-orthogonal weirdness from bleeding\n    schematic[\"rooms\"].append({\n        \"id\": seed_mapping[i][\"id\"],\n        \"name\": seed_mapping[i][\"name\"],\n        \"polygon\": room['polygon']\n    })\n\nwith open('draft.json', 'w') as f:\n    json.dump(schematic, f)\nEOF" action.permission=* action.action=allow action.pattern=*
