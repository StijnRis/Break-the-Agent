[978, 1159], \"p2\": [1407, 1159], \"thickness_px\": 10}, # 0.14, 0.15 | 0.18, 0.19\n    {\"p1\": [1407, 1161.5], \"p2\": [1557, 1161.5], \"thickness_px\": 5}, # 0.16 | 0.19\n    \n    # V walls\n    {\"p1\": [1308, 121], \"p2\": [1308, 332], \"thickness_px\": 6}, # 0.02 | 0.03\n    {\"p1\": [1246.5, 344], \"p2\": [1246.5, 536], \"thickness_px\": 13}, # 0.07 | 0.20\n    {\"p1\": [1386.5, 341], \"p2\": [1386.5, 421], \"thickness_px\": 49}, # 0.04 | 0.20\n    {\"p1\": [1166, 540], \"p2\": [1166, 675], \"thickness_px\": 12}, # 0.08 | 0.10\n    {\"p1\": [1366.5, 445], \"p2\": [1366.5, 563], \"thickness_px\": 11}, # 0.05 | 0.20\n    {\"p1\": [1368.5, 573], \"p2\": [1368.5, 758], \"thickness_px\": 7}, # 0.06 | 0.20\n    {\"p1\": [1108.5, 675], \"p2\": [1108.5, 766], \"thickness_px\": 1}, # 0.09 | 0.10\n    {\"p1\": [1279, 770], \"p2\": [1279, 987], \"thickness_px\": 10}, # 0.12 | 0.20\n    {\"p1\": [1360.5, 926], \"p2\": [1360.5, 1048], \"thickness_px\": 13}, # 0.20 | 0.13\n    {\"p1\": [1248.5, 1000], \"p2\": [1248.5, 1154], \"thickness_px\": 1}, # 0.14 | 0.15\n    {\"p1\": [1384.5, 1000], \"p2\": [1384.5, 1154], \"thickness_px\": 45}, # 0.15 | 0.16 (wait, 0.16 x starts 1407, 0.15 x ends 1362. Dist = 45. Center = 1384.5)\n    {\"p1\": [1308, 1164], \"p2\": [1308, 1373], \"thickness_px\": 4}, # 0.18 | 0.19\n]\n\nwalls.extend(interior_walls)\ndata['walls'] = walls\nwith open('/tmp/opencode/draft.json', 'w') as f:\n    json.dump(data, f)\nEOF" action.permission=* action.action=allow action.pattern=*
