timestamp=2026-11-14T15:19:06.015Z level=INFO run=dc2e588b message=evaluated permission=bash pattern="cat << 'EOF' > /tmp/opencode/filter_doors.py\nimport json\nimport math\n\nwith open('/tmp/opencode/segments.json') as f:\n    segs = json.load(f)\n\nlines = []\nfor r in segs:\n    poly = r['polygon']\n    for i in range(len(poly)):\n        p1 = poly[i]\n        p2 = poly[(i+1)%len(poly)]\n        if p1 == p2: continue\n        lines.append({'room': r['seed'], 'p1': p1, 'p2': p2})\n\ndoors = []\nused = set()\nfor i, l1 in enumerate(lines):\n    if i in used: continue\n    for j, l2 in enumerate(lines):\n        if j <= i or j in used: continue\n        if l1['room'] == l2['room']: continue\n        \n        dx1, dy1 = l1['p2'][0] - l1['p1'][0], l1['p2'][1] - l1['p1'][1]\n        dx2, dy2 = l2['p2'][0] - l2['p1'][0], l2['p2'][1] - l2['p1'][1]\n        len1 = math.hypot(dx1, dy1)\n        len2 = math.hypot(dx2, dy2)\n        \n        if len1 < 25 or len2 < 25 or len1 > 70 or len2 > 70: \n            continue # Door length must be between 25 and 70\n        \n        nx1, ny1 = dx1/len1, dy1/len1\n        nx2, ny2 = dx2/len2, dy2/len2\n        \n        dot = nx1*nx2 + ny1*ny2\n        if abs(dot) > 0.99: \n            cx1, cy1 = (l1['p1'][0] + l1['p2'][0])/2, (l1['p1'][1] + l1['p2'][1])/2\n            cx2, cy2 = (l2['p1'][0] + l2['p2'][0])/2, (l2['p1'][1] + l2['p2'][1])/2\n            perp_dist = abs((cx2-cx1)*ny1 - (cy2-cy1)*nx1)\n            par_dist = abs((cx2-cx1)*nx1 + (cy2-cy1)*ny1)\n            \n            if perp_dist < 20 and par_dist < max(len1, len2)/2:\n                print(f\"Door between {l1['room']} and {l2['room']}: {l1['p1']} - {l1['p2']} (len {len1:.1f})\")\n                doors.append({\"p1\": l1['p1'], \"p2\": l1['p2']})\n                used.add(i)\n                used.add(j)\n\nwith open('/tmp/opencode/doors.json', 'w') as f:\n    json.dump(doors, f)\nEOF" action.permission=* action.action=allow action.pattern=*
timestamp=2026-11-14T15:19:06.016Z level=INFO run=dc2e588b message=evaluated permission=bash pattern="python3 /tmp/opencode/filter_doors.py" action.permission=* action.action=allow action.pattern=*
