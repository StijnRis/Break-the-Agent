timestamp=2026-11-14T14:30:41.188Z level=INFO run=e3ec62d7 message=evaluated permission=bash pattern="cat << 'EOF' > deduplicate_walls.py\nimport json\nimport math\n\nwith open(\"final_with_walls.json\") as f:\n    data = json.load(f)\n\nwalls = data[\"walls\"]\n\ndef dist(p1, p2):\n    return math.hypot(p1[0]-p2[0], p1[1]-p2[1])\n\ndef point_to_segment(p, a, b):\n    l2 = dist(a, b)**2\n    if l2 == 0: return dist(p, a)\n    t = max(0, min(1, ((p[0]-a[0])*(b[0]-a[0]) + (p[1]-a[1])*(b[1]-a[1])) / l2))\n    proj = [a[0] + t*(b[0]-a[0]), a[1] + t*(b[1]-a[1])]\n    return proj\n\ndef are_parallel(s1, s2):\n    dx1, dy1 = s1[\"p2\"][0] - s1[\"p1\"][0], s1[\"p2\"][1] - s1[\"p1\"][1]\n    dx2, dy2 = s2[\"p2\"][0] - s2[\"p1\"][0], s2[\"p2\"][1] - s2[\"p1\"][1]\n    len1 = math.hypot(dx1, dy1)\n    len2 = math.hypot(dx2, dy2)\n    if len1 == 0 or len2 == 0: return False\n    dot = (dx1*dx2 + dy1*dy2) / (len1*len2)\n    return abs(dot) > 0.99\n\nmerged_walls = []\nused = [False] * len(walls)\n\nfor i in range(len(walls)):\n    if used[i]: continue\n    s1 = walls[i]\n    found_match = False\n    for j in range(i+1, len(walls)):\n        if used[j]: continue\n        s2 = walls[j]\n        if are_parallel(s1, s2):\n            proj1 = point_to_segment(s1[\"p1\"], s2[\"p1\"], s2[\"p2\"])\n            proj2 = point_to_segment(s1[\"p2\"], s2[\"p1\"], s2[\"p2\"])\n            d1 = dist(s1[\"p1\"], proj1)\n            d2 = dist(s1[\"p2\"], proj2)\n            \n            # Check if they overlap in projection\n            len_s1 = dist(s1[\"p1\"], s1[\"p2\"])\n            proj_len = dist(proj1, proj2)\n            \n            if d1 < 25 and d2 < 25 and proj_len > 0.5 * len_s1:\n                # They are opposite sides of the same interior wall\n                # Average them\n                avg_p1 = [(s1[\"p1\"][0] + proj1[0])/2, (s1[\"p1\"][1] + proj1[1])/2]\n                avg_p2 = [(s1[\"p2\"][0] + proj2[0])/2, (s1[\"p2\"][1] + proj2[1])/2]\n                merged_walls.append({\"p1\": avg_p1, \"p2\": avg_p2, \"thickness_px\": d1 * 2})\n                used[j] = True\n                found_match = True\n                break\n    if not found_match:\n        # Exterior wall or unmatched\n        # Offset it outwards by 10 pixels to approximate center of exterior wall?\n        # Let's just leave it, or push it slightly based on bounding box.\n        # It's better than nothing.\n        merged_walls.append(s1)\n    used[i] = True\n\ndata[\"walls\"] = merged_walls\nwith open(\"final_with_walls2.json\", \"w\") as f:\n    json.dump(data, f)\nEOF" action.permission=* action.action=allow action.pattern=*
